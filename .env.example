# Copy to an ignored local env file; never commit actual credentials.
# Disabled until a separate isolated staging project is securely configured.
APP_MODE=fictional_preview
APP_ORIGIN=http://127.0.0.1:8080
AGENCY_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
INTAKE_DATABASE_URL=
INTAKE_HASH_SECRET=
INTAKE_ENABLED=false
# Reserved: setting this disables intake until frontend challenge is implemented.
TURNSTILE_SECRET_KEY=

# Kixie: disabled, isolated fictional fixtures only. No live switch exists here.
KIXIE_PREVIEW_ENABLED=false
KIXIE_FIXTURE_ONLY=true
# Distinct restricted PostgreSQL LOGIN, granted agency_kixie and bound to AGENCY_ID.
KIXIE_DATABASE_URL=
KIXIE_BUSINESS_ID=
# Generate >=32 random base64url characters locally; set as X-Kixie-Webhook-Token.
# This is a separately generated inbound secret, NOT the Kixie API key.
KIXIE_WEBHOOK_SECRET=
# Leave empty unless the account's legacy timestamps are verified to be UTC.
KIXIE_LEGACY_TIMESTAMPS_UTC=
