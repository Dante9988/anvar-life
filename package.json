    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "pg": "^8.23.1"
  }
}
